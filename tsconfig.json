{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@agent/core": ["./packages/core/src"],
      "@agent/core/*": ["./packages/core/src/*"],
      "@agent/sdk": ["./packages/sdk/src"]
    }
  },
  "exclude": ["node_modules", "dist", "packages/desktop/renderer", "packages/sdk/dist"]
}
