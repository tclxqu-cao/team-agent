# Copy to .env.local. This example address must be replaced with your Mac's
# Tailscale IP or another reachable service origin. Never use localhost here.
AGENT_MOBILE_ACCESS_URL=http://100.x.y.z
# Optional: local gateway used by the development proxy and pairing middleware.
AGENT_DEV_BACKEND_URL=http://127.0.0.1:3000
# Optional: comma-separated origins or hostnames allowed by the Vite host check.
# AGENT_WEB_ALLOWED_ORIGINS=https://your-machine.your-tailnet.ts.net
