{
  "name": "agentroam",
  "version": "0.2.0-preview.6",
  "description": "Zero-install mobile remote terminal and file console",
  "type": "module",
  "bin": {
    "agentroam": "./bin/agentroam.mjs",
    "agent-tui": "./bin/agent-tui.mjs"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "files": [
    "bin",
    "dist",
    "runtime",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/cli/src",
    "prepack": "node ../../scripts/stage-cli-runtime.mjs && npm run build"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "undici": "^6.25.0"
  },
  "optionalDependencies": {
    "agentroam-cloudflared-darwin-arm64": "0.2.0-preview.6",
    "agentroam-tui-darwin-arm64": "0.2.0-preview.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "preview"
  }
}
