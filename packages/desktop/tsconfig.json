{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@agent/computer-use": ["../computer-use/src"],
      "@agent/computer-use/*": ["../computer-use/src/*"],
      "@agent/core": ["../core/src"],
      "@agent/core/*": ["../core/src/*"]
    }
  },
  "include": ["main", "renderer"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
