# Default: local Sherpa ASR + MLX TTS. Change to azure and restart the sidecar.
# Copy to a private file outside Git, then run from the repository root:
# node --env-file=/absolute/path/voice.env packages/voice-service/dist/main.js
VOICE_PROVIDER=local
VOICE_SERVICE_HOST=127.0.0.1
VOICE_SERVICE_PORT=17863
# Set a token if the service binds to a non-loopback interface.
# VOICE_SERVICE_TOKEN=

# Only required with VOICE_PROVIDER=azure; never expose these to the browser.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_LANGUAGE=zh-CN
AZURE_SPEECH_VOICE=zh-CN-XiaoxiaoNeural

# Existing local model/runtime settings continue to work in local mode.
# VOICE_ASR_MODEL_DIR=/absolute/path/to/sherpa-asr
# VOICE_KWS_MODEL_DIR=/absolute/path/to/sherpa-kws
# VOICE_TTS_PYTHON=/absolute/path/to/python
# VOICE_TTS_VOICE=Serena
