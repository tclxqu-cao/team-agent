{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@agent/core": [
        "../core/src"
      ],
      "@agent/core/*": [
        "../core/src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true
  },
  "include": [
    "app",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev-selftest/types/**/*.ts",
    ".next-dev-web-picker/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-shared-verify/types/**/*.ts",
    ".next-shared-dev/types/**/*.ts",
    ".next-release-20260911-184156/types/**/*.ts",
    ".next-full-20260914/types/**/*.ts",
    ".next-8af62fd/types/**/*.ts",
    ".next-goaltest/types/**/*.ts"
  ]
}
