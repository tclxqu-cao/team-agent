{
  "name": "@agent/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "AgentRoam Android/iOS \u58f3\uff1aCapacitor \u6253\u5305 packages/webapp \u6784\u5efa\u4ea7\u7269\uff0c\u901a\u8fc7\u53ef\u914d\u7f6e\u7684\u8fdc\u7aef\u670d\u52a1\u5668\u5730\u5740\u4f7f\u7528 Agent \u80fd\u529b",
  "scripts": {
    "sync": "cd ../webapp && bun run build && cd ../mobile && cap sync && node scripts/patch-safe-area.mjs",
    "patch": "node scripts/patch-safe-area.mjs",
    "sync:web": "cap copy",
    "update": "cap update android && cap update ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/barcode-scanner": "2.2.0",
    "capacitor-secure-storage-plugin": "0.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
