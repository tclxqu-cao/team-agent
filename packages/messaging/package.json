{
  "name": "@agent/messaging",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.22.0" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "node build.mjs && bunx tsc --emitDeclarationOnly",
