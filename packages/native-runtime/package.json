{
  "name": "@agent/native-runtime",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.22.0" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "bun build ./src/index.ts --outdir ./dist --target node --format esm --sourcemap=external --external @agent/core --external @opencode-ai/sdk --external @anthropic-ai/claude-agent-sdk --watch",
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --sourcemap=external --external @agent/core --external @opencode-ai/sdk --external @anthropic-ai/claude-agent-sdk && bunx tsc --emitDeclarationOnly",
    "test": "bunx vitest run"
  },
  "dependencies": {
    "@agent/core": "*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.259",
    "@opencode-ai/sdk": "1.18.27",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
